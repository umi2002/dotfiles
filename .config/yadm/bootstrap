#!/bin/bash

set -Eeuo pipefail

trap 'echo "Bootstrap failed at line $LINENO: $BASH_COMMAND" >&2' ERR

if [[ $EUID -eq 0 ]]; then
    echo "Run this as your normal user, not as root." >&2
    exit 1
fi

missing=()
for cmd in aconfmgr gsettings setup-secrets sync-greeter systemctl yadm; do
    command -v "$cmd" >/dev/null || missing+=("$cmd")
done
if ((${#missing[@]} > 0)); then
    echo "Missing required commands: ${missing[*]}" >&2
    exit 1
fi

sudo -v

aconfmgr apply
echo "Aconfmgr apply successful."

UNITS=(
    cliphist-image.service
    cliphist-text.service
    emacs.service
    hypridle.service
    hyprpaper.service
    hyprpolkitagent.service
    quickshell.service
    sysupdate-check.timer
    udiskie.service
)

UNITS_Laptop=(
    hyprsunset.service
)

UNITS_Desktop=()

CLASS="$(yadm config --get local.class 2>/dev/null || true)"
if [[ -z $CLASS ]]; then
    echo "Warning: yadm local.class is unset, enabling common units only." >&2
elif declare -p "UNITS_$CLASS" >/dev/null 2>&1; then
    declare -n class_units="UNITS_$CLASS"
    UNITS+=("${class_units[@]}")
    echo "Class '$CLASS' contributes ${#class_units[@]} unit(s)."
else
    echo "Warning: no unit list defined for class '$CLASS', enabling common units only." >&2
fi

USER_UNIT_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/yadm-bootstrap"
STATE_FILE="$STATE_DIR/managed-user-units"

systemctl --user daemon-reload

declare -A desired=()
for unit in "${UNITS[@]}"; do
    desired[$unit]=1
done

declare -A claimed=()
if [[ -f $STATE_FILE ]]; then
    while read -r unit || [[ -n $unit ]]; do
        [[ -n $unit ]] && claimed[$unit]=1
    done <"$STATE_FILE"
fi
for path in "$USER_UNIT_DIR"/*.service "$USER_UNIT_DIR"/*.timer "$USER_UNIT_DIR"/*.socket; do
    [[ -f $path && ! -L $path ]] || continue
    unit=${path##*/}
    [[ $(systemctl --user is-enabled "$unit" 2>/dev/null) == enabled ]] && claimed[$unit]=1
done

stale=()
for unit in "${!claimed[@]}"; do
    [[ -v desired[$unit] ]] || stale+=("$unit")
done

if ((${#stale[@]} > 0)); then
    failed_disable=()
    for unit in "${stale[@]}"; do
        systemctl --user disable --now "$unit" 2>/dev/null || failed_disable+=("$unit")
    done
    echo "Disabled units no longer declared: ${stale[*]}"
    if ((${#failed_disable[@]} > 0)); then
        echo "Warning: could not disable: ${failed_disable[*]}" >&2
    fi
fi

systemctl --user enable "${UNITS[@]}" ||
    echo "Warning: some user services could not be enabled." >&2

not_enabled=()
for unit in "${UNITS[@]}"; do
    case "$(systemctl --user is-enabled "$unit" 2>/dev/null)" in
    enabled | enabled-runtime | static | indirect | generated | alias) ;;
    *) not_enabled+=("$unit") ;;
    esac
done
if ((${#not_enabled[@]} > 0)); then
    echo "Warning: these units are still not enabled: ${not_enabled[*]}" >&2
else
    echo "Enabling user services successful."
fi

mkdir -p "$STATE_DIR"
printf '%s\n' "${UNITS[@]}" >"$STATE_FILE.tmp" && mv -f "$STATE_FILE.tmp" "$STATE_FILE"

for group in docker informant keyd kvm libvirt uucp video wheel; do
    if getent group "$group" >/dev/null; then
        sudo usermod -aG "$group" "$(whoami)"
    fi
done
echo "Adding user to groups successful."

sync-greeter

if getent passwd greeter >/dev/null; then
    sudo mkdir -p /var/lib/greeter
    sudo chown greeter:greeter /var/lib/greeter
    sudo usermod -d /var/lib/greeter greeter
    echo "Created home directory and granted correct permissions for greeter user."
else
    echo "Warning: no 'greeter' user yet, skipping its home directory setup." >&2
fi

setup-secrets

if [[ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ]]; then
    gsettings set org.gnome.desktop.interface gtk-theme 'Fluent-Dark'
    gsettings set org.gnome.desktop.interface icon-theme 'Adwaita'
    gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark'
    echo "Setup gtk settings successful."
else
    echo "Warning: no session bus, skipping gtk settings. Re-run from a desktop session." >&2
fi

echo "Bootstrap complete"
