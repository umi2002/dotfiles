#!/bin/bash

set -Eeuo pipefail

trap 'echo "Bootstrap failed at line $LINENO: $BASH_COMMAND" >&2' ERR

if [[ $EUID -eq 0 ]]; then
    echo "Run this as your normal user, not as root." >&2
    exit 1
fi

missing=()
for cmd in aconfmgr gsettings setup-secrets sync-greeter systemctl; do
    command -v "$cmd" >/dev/null || missing+=("$cmd")
done
if ((${#missing[@]} > 0)); then
    echo "Missing required commands: ${missing[*]}" >&2
    exit 1
fi

sudo -v

aconfmgr apply
echo "Aconfmgr apply successful."

UNITS=(
    cliphist-image.service
    cliphist-text.service
    emacs.service
    hypridle.service
    hyprpaper.service
    hyprpolkitagent.service
    hyprsunset.service
    quickshell.service
    sysupdate-check.timer
    udiskie.service
)

systemctl --user daemon-reload
systemctl --user enable "${UNITS[@]}" ||
    echo "Warning: some user services could not be enabled." >&2

not_enabled=()
for unit in "${UNITS[@]}"; do
    case "$(systemctl --user is-enabled "$unit" 2>/dev/null)" in
    enabled | enabled-runtime | static | indirect | generated | alias) ;;
    *) not_enabled+=("$unit") ;;
    esac
done
if ((${#not_enabled[@]} > 0)); then
    echo "Warning: these units are still not enabled: ${not_enabled[*]}" >&2
else
    echo "Enabling user services successful."
fi

for group in docker informant keyd kvm libvirt uucp video wheel; do
    if getent group "$group" >/dev/null; then
        sudo usermod -aG "$group" "$(whoami)"
    fi
done
echo "Adding user to groups successful."

sync-greeter

if getent passwd greeter >/dev/null; then
    sudo mkdir -p /var/lib/greeter
    sudo chown greeter:greeter /var/lib/greeter
    sudo usermod -d /var/lib/greeter greeter
    echo "Created home directory and granted correct permissions for greeter user."
else
    echo "Warning: no 'greeter' user yet, skipping its home directory setup." >&2
fi

setup-secrets

if [[ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ]]; then
    gsettings set org.gnome.desktop.interface gtk-theme 'Fluent-Dark'
    gsettings set org.gnome.desktop.interface icon-theme 'Adwaita'
    gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark'
    echo "Setup gtk settings successful."
else
    echo "Warning: no session bus, skipping gtk settings. Re-run from a desktop session." >&2
fi

echo "Bootstrap complete"
