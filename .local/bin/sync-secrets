#!/bin/bash

set -euo pipefail

SECRETS_PATH="$HOME/.config/quickshell/Secrets.qml"

if [[ ! -s "$SECRETS_PATH" ]]; then
    echo "$SECRETS_PATH is missing or empty, refusing to overwrite the vault copy." >&2
    exit 1
fi
if ! grep -qE '^[[:space:]]*(pragma|import)[[:space:]]|QtObject' "$SECRETS_PATH"; then
    echo "$SECRETS_PATH does not look like QML, refusing to overwrite the vault copy." >&2
    exit 1
fi

BW_SESSION=$(bw-session)
export BW_SESSION
trap 'bw lock >/dev/null 2>&1 || true' EXIT

ITEM=$(bw get item "Secrets.qml" --session "$BW_SESSION")
ITEM_ID=$(jq -r '.id' <<<"$ITEM")

jq --rawfile content "$SECRETS_PATH" '.notes = $content' <<<"$ITEM" |
    bw encode --session "$BW_SESSION" |
    bw edit item "$ITEM_ID" --session "$BW_SESSION"
