#!/bin/bash

set -euo pipefail

ENV_PATH="$HOME/.config/desktop_secrets.env"
ITEM_NAME="desktop_secrets.env"

if [[ ! -s "$ENV_PATH" ]]; then
    echo "$ENV_PATH is missing or empty, refusing to overwrite the vault copy." >&2
    exit 1
fi
if ! grep -qE '^[A-Z][A-Z0-9_]*=.+' "$ENV_PATH"; then
    echo "$ENV_PATH has no KEY=value lines, refusing to overwrite the vault copy." >&2
    exit 1
fi
if grep -qvE '^([A-Z][A-Z0-9_]*=.*|#.*|)$' "$ENV_PATH"; then
    echo "$ENV_PATH has lines that are neither KEY=value, comments nor blank. Aborting." >&2
    exit 1
fi

BW_SESSION=$(bw-session)
export BW_SESSION
trap 'bw lock >/dev/null 2>&1 || true' EXIT

if ITEM=$(bw get item "$ITEM_NAME" --session "$BW_SESSION" 2>/dev/null); then
    ITEM_ID=$(jq -r '.id' <<<"$ITEM")
    jq --rawfile content "$ENV_PATH" '.notes = $content' <<<"$ITEM" |
        bw encode --session "$BW_SESSION" |
        bw edit item "$ITEM_ID" --session "$BW_SESSION" >/dev/null
    echo "Updated $ITEM_NAME in Bitwarden."
else
    bw get template item --session "$BW_SESSION" |
        jq --rawfile content "$ENV_PATH" \
            '.type = 2 | .name = "'"$ITEM_NAME"'" | .notes = $content | .login = null | .secureNote = {type: 0}' |
        bw encode --session "$BW_SESSION" |
        bw create item --session "$BW_SESSION" >/dev/null
    echo "Created $ITEM_NAME in Bitwarden."
fi
