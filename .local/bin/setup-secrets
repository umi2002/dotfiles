#!/bin/bash

set -Eeuo pipefail

trap 'echo "setup-secrets failed at line $LINENO: $BASH_COMMAND" >&2' ERR

missing=()
for cmd in bw bw-session fzf gh ssh-keygen; do
    command -v "$cmd" >/dev/null || missing+=("$cmd")
done
if ((${#missing[@]} > 0)); then
    echo "Missing required commands: ${missing[*]}" >&2
    exit 1
fi

ENV_PATH="$HOME/.config/desktop_secrets.env"
QML_PATH="$HOME/.config/quickshell/Secrets.qml"
ENV_TMP=$(mktemp)
QML_TMP=$(mktemp)

cleanup() {
    rm -f "$ENV_TMP" "$QML_TMP"
    bw lock >/dev/null 2>&1 || true
}
trap cleanup EXIT

echo "Unlocking Bitwarden..."
BW_SESSION=$(bw-session)
export BW_SESSION

if bw get notes "desktop_secrets.env" --session "$BW_SESSION" >"$ENV_TMP" 2>/dev/null && [[ -s "$ENV_TMP" ]]; then
    echo "Read secrets.env from Bitwarden."
elif bw get notes "Secrets.qml" --session "$BW_SESSION" >"$QML_TMP" 2>/dev/null && [[ -s "$QML_TMP" ]]; then
    echo "No secrets.env in Bitwarden, converting the legacy Secrets.qml note."
    sed -nE 's/^[[:space:]]*readonly property string ([A-Za-z_]+):[[:space:]]*"(.*)"[[:space:]]*$/\1=\2/p' \
        "$QML_TMP" | while IFS='=' read -r key value; do
        printf '%s=%s\n' "${key^^}" "$value"
    done >"$ENV_TMP"
else
    echo "Could not read secrets from Bitwarden, aborting. $ENV_PATH and $QML_PATH left untouched." >&2
    exit 1
fi

if ! grep -qE '^[A-Z][A-Z0-9_]*=.+' "$ENV_TMP"; then
    echo "Bitwarden returned nothing shaped like KEY=value, aborting. $ENV_PATH and $QML_PATH left untouched." >&2
    exit 1
fi
if grep -qE '^[A-Z][A-Z0-9_]*=.*[\\"]' "$ENV_TMP"; then
    echo "A secret contains a quote or backslash, which cannot be rendered into QML. Aborting." >&2
    exit 1
fi

{
    printf 'pragma Singleton\npragma ComponentBehavior: Bound\n\nimport QtQuick\n\nQtObject {\n'
    while IFS='=' read -r key value; do
        [[ -z "$key" || "$key" == \#* ]] && continue
        printf '    readonly property string %s: "%s"\n' "${key,,}" "$value"
    done <"$ENV_TMP"
    printf '}\n'
} >"$QML_TMP"

install -m 600 "$ENV_TMP" "$ENV_PATH"
install -m 600 "$QML_TMP" "$QML_PATH"
echo "Setting up secrets successful."

GITHUB_PAT=$(bw get notes "Github Personal Access Token" --session "$BW_SESSION" | tr -d '[:space:]' || true)
if [[ -z "$GITHUB_PAT" ]]; then
    echo "Could not read the GitHub PAT from Bitwarden, aborting." >&2
    exit 1
fi

if ! GH_TOKEN="$GITHUB_PAT" gh auth status &>/dev/null; then
    echo "The GitHub PAT was rejected, aborting before the existing SSH key is replaced." >&2
    exit 1
fi

KEY_PATH="$HOME/.ssh/id_ed25519_github"
KEY_COMMENT="$(whoami)@$(hostname)"
mkdir -p "$HOME/.ssh" && chmod 700 "$HOME/.ssh"

KEYS_LIST=$(GH_TOKEN="$GITHUB_PAT" gh api user/keys --paginate \
    --jq '.[] | "\(.title)\t\(.id)"' || true)
mapfile -t KEY_ENTRIES < <(printf '%s\n' "$KEYS_LIST" | awk -F'\t' 'NF && $1 != "" {print "~ Replace: " $1}')
SELECTED=$(printf '%s\n' "+ Add as new key" "${KEY_ENTRIES[@]}" | fzf \
    --prompt="GitHub SSH key action: " \
    --layout=reverse --height=40% --border) || SELECTED=""

if [[ -z "$SELECTED" ]]; then
    echo "No GitHub SSH key action selected, leaving the existing key in place."
else
    rm -f "$KEY_PATH.new" "$KEY_PATH.new.pub"
    ssh-keygen -t ed25519 -f "$KEY_PATH.new" -C "$KEY_COMMENT" -N ""

    if [[ "$SELECTED" == "+ Add as new key" ]]; then
        KEY_TITLE="$KEY_COMMENT"
        OLD_KEY_ID=""
    else
        KEY_TITLE="${SELECTED#\~ Replace: }"
        OLD_KEY_ID=$(echo "$KEYS_LIST" | awk -F'\t' -v t="$KEY_TITLE" '$1 == t {print $2; exit}')
    fi

    if ! GH_TOKEN="$GITHUB_PAT" gh ssh-key add "$KEY_PATH.new.pub" --title "$KEY_TITLE"; then
        rm -f "$KEY_PATH.new" "$KEY_PATH.new.pub"
        echo "Uploading the new SSH key failed, aborting. The existing key is unchanged." >&2
        exit 1
    fi

    mv -f "$KEY_PATH.new" "$KEY_PATH"
    mv -f "$KEY_PATH.new.pub" "$KEY_PATH.pub"

    if [[ -n "$OLD_KEY_ID" ]]; then
        GH_TOKEN="$GITHUB_PAT" gh ssh-key delete "$OLD_KEY_ID" --yes ||
            echo "Warning: the new key was uploaded but the old one could not be deleted." >&2
        echo "GitHub SSH key replaced."
    else
        echo "GitHub SSH key added."
    fi
fi
echo "GitHub SSH key setup successful."
